# Enable Banking API token. Keep the real .env file private.
ENABLE_BANKING_TOKEN=replace-with-your-token

# Optional settings
ENABLE_BANKING_APP_NAME="My app"
ENABLE_BANKING_ENVIRONMENT=SANDBOX
ENABLE_BANKING_CERTIFICATE_FILE=public.crt
ENABLE_BANKING_PRIVATE_KEY_FILE=private.key
ENABLE_BANKING_CERTIFICATE_DAYS=365
ENABLE_BANKING_CERTIFICATE_SUBJECT="/C=XX/O=My app/CN=localhost"
ENABLE_BANKING_REDIRECT_URL=https://localhost:13579/callback

# Required when ENABLE_BANKING_ENVIRONMENT=PRODUCTION
# ENABLE_BANKING_DESCRIPTION="Read-only personal finance access"
# ENABLE_BANKING_GDPR_EMAIL=privacy@example.org
ENABLE_BANKING_PRIVACY_URL=https://bestcwg.github.io/bank-advisor-test/privacy.html
ENABLE_BANKING_TERMS_URL=https://bestcwg.github.io/bank-advisor-test/terms.html
